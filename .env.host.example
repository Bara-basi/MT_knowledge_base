# Overrides container-DNS values when API/Harness processes run on the host.
# Secrets remain in the untracked .env file and are not duplicated here.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MILVUS_URI=http://127.0.0.1:19530
MINIO_ENDPOINT=http://127.0.0.1:9000
NEO4J_URI=bolt://127.0.0.1:7687

HARNESS_ENABLED=true
HARNESS_WORKDIR=/opt/mtsco-knowledge-base/data/processing
HARNESS_SESSION_ROOT=/opt/mtsco-knowledge-base/data/harness_sessions
HARNESS_CONTEXT_ARCHIVE_TOKENS=90000
HARNESS_GLOBAL_CONCURRENCY=2
# New Harness flow: FastAPI accepts Feishu events and runs the answer task in
# process.  Do not enable the retired PostgreSQL answer-worker on this host.
FEISHU_DURABLE_QUEUE_ENABLED=false
SHARED_RATE_LIMIT_ENABLED=true
