# Overrides container-DNS values when API/Harness processes run on the host.
# Secrets remain in the untracked .env file and are not duplicated here.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MILVUS_URI=http://127.0.0.1:19530
MINIO_ENDPOINT=http://127.0.0.1:9000
NEO4J_URI=bolt://127.0.0.1:7687

# Model/BM25 runtime cache. This directory must be writable by the `mtsco`
# systemd user; keep it inside the deployed checkout by default.
EMBEDDING_CACHE_DIR=/opt/mtsco-knowledge-base/data/models
RERANKER_CACHE_DIR=/opt/mtsco-knowledge-base/data/models

HARNESS_ENABLED=true
HARNESS_WORKDIR=/opt/mtsco-knowledge-base/data/harness
HARNESS_SESSION_ROOT=/opt/mtsco-knowledge-base/data/harness_sessions
HARNESS_CONTEXT_ARCHIVE_TOKENS=90000
HARNESS_GLOBAL_CONCURRENCY=2
# Quote scoring bypasses Harness and uses one JSON-constrained model call.
QUOTE_SCORE_FINALIZER_MODEL=deepseek-v4-flash
QUOTE_SCORE_FINALIZER_MAX_TOKENS=4096
QUOTE_SCORE_ENABLE_THINKING=false
# New Harness flow: FastAPI accepts Feishu events and runs the answer task in
# process.  Do not enable the retired PostgreSQL answer-worker on this host.
FEISHU_DURABLE_QUEUE_ENABLED=false
SHARED_RATE_LIMIT_ENABLED=true
