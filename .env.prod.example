COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml
GENERIC_TIMEZONE=Asia/Shanghai

# Prod uses server-friendly mirror sources. Override these in the untracked
# .env file if the server registry changes.
PYTHON_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/python:3.11-slim
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2024-05-24T09-08-49Z
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-05-28T17-19-04Z
MILVUS_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/milvusdb/milvus:v2.6.15-amd64
NEO4J_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/neo4j:5.26.9-community
POSTGRES_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/postgres:16-alpine

API_HOST_PORT=8000
API_WORKERS=4
API_TIMEOUT_KEEP_ALIVE=30
API_ROUTE_PREFIX=/prod
FEISHU_ROUTE_PREFIX=/prod
DEV_PROXY_TARGET=http://host.docker.internal:18000
DEV_PROXY_TIMEOUT=600
PUBLIC_BASE_URL=https://your-public-domain.example/prod

POSTGRES_DB=mtsco_knowledge_base
POSTGRES_USER=mtsco
POSTGRES_PASSWORD=change-me
POSTGRES_CHAT_TABLE=chat_messages
POSTGRES_EXTERNAL_CHAT_TABLE=chat_messages_external
POSTGRES_TIMEZONE=Asia/Shanghai
CHAT_MESSAGE_ENCRYPTION_KEY=change-me-to-a-long-random-chat-message-key

MINIO_ACCESS_KEY_ID=change-me-access-key
MINIO_SECRET_ACCESS_KEY=change-me
MINIO_INTERNAL_ENDPOINT=http://milvus-minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
APP_MINIO_BUCKET=knowledge-raw-docs
MINIO_STANDARD_ASSET_BUCKET=knowledge-standard-assets
MINIO_PROCESSED_DOCUMENT_BUCKET=knowledge-processed-docs
MINIO_SECURE=false

USE_LOCAL_EMBEDDING_MODEL=false
USE_LOCAL_RERANK_MODEL=false
SKIP_RETRIEVAL_WARMUP=true
MODEL_CACHE_DIR=E:/models

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Enable only after scripts/harness/install-linux.sh has completed its probe.
DEEPSEEK_API_KEY=
HARNESS_ENABLED=false
HARNESS_MODEL=deepseek-v4-flash
HARNESS_PROVIDER=deepseek
HARNESS_TIMEOUT=600
HARNESS_IDLE_SECONDS=25200
HARNESS_CONTEXT_ARCHIVE_TOKENS=90000
HARNESS_GLOBAL_CONCURRENCY=2
HARNESS_WORKDIR=data/processing
HARNESS_SESSION_ROOT=data/harness_sessions
HARNESS_NATIVE_JSONL_RESUME=true
HARNESS_MEMORY_BUCKET=knowledge-chat-memory
HARNESS_SCHEDULER_INTERVAL_SECONDS=300
HARNESS_ATTACHMENT_ROOT=data/harness_attachments
HARNESS_ATTACHMENT_MAX_BYTES=52428800
HARNESS_ATTACHMENT_TTL_SECONDS=86400
HARNESS_ATTACHMENT_API_TOKEN=

# Feishu webhook durability and shared production controls.
FEISHU_DURABLE_QUEUE_ENABLED=false
ANSWER_WORKER_CONCURRENCY=2
ANSWER_WORKER_POLL_SECONDS=1
ANSWER_JOB_LEASE_SECONDS=900
ANSWER_JOB_MAX_ATTEMPTS=6
SHARED_RATE_LIMIT_ENABLED=true
FEISHU_RATE_LIMIT_PER_MINUTE=10
FEISHU_RATE_LIMIT_BURST=3
EXTERNAL_RATE_LIMIT_PER_MINUTE=60


LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT=30
FEISHU_CONNECT_RETRIES=2
FEISHU_FEEDBACK_WINDOW_SECONDS=1800
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TARGET_UNION_ID=on_ebc25d5669cabb3440819db2cfaa5c7c
DAILY_REPORT_TARGET_SESSION_ID=oc_b4325718ab22291bc7625ebd63d6f915
DAILY_REPORT_TIMEZONE=Asia/Shanghai
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_TARGET_UNION_ID=on_ebc25d5669cabb3440819db2cfaa5c7c
WEEKLY_REPORT_TARGET_SESSION_ID=oc_b4325718ab22291bc7625ebd63d6f915
WEEKLY_REPORT_TIMEZONE=Asia/Shanghai

NEO4J_PASSWORD=change-me
NEO4J_URI=bolt://neo4j:7687
NEO4J_INTERNAL_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT=10
NEO4J_GRAPH_NAME=MTSCO知识图谱
