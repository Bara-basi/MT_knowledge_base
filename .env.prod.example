COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml
GENERIC_TIMEZONE=Asia/Shanghai

API_HOST_PORT=8000
API_WORKERS=4
API_TIMEOUT_KEEP_ALIVE=30
API_ROUTE_PREFIX=/prod
FEISHU_ROUTE_PREFIX=/prod
DEV_PROXY_TARGET=http://host.docker.internal:18000
DEV_PROXY_TIMEOUT=600
PUBLIC_BASE_URL=https://your-public-domain.example/prod

POSTGRES_DB=mtsco_knowledge_base
POSTGRES_USER=mtsco
POSTGRES_PASSWORD=change-me
POSTGRES_CHAT_TABLE=chat_messages
CHAT_MESSAGE_ENCRYPTION_KEY=change-me-to-a-long-random-chat-message-key

MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=change-me
MINIO_INTERNAL_ENDPOINT=http://milvus-minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
APP_MINIO_BUCKET=knowledge-raw-docs
MINIO_SECURE=false

USE_LOCAL_EMBEDDING_MODEL=false
USE_LOCAL_RERANK_MODEL=false
SKIP_RETRIEVAL_WARMUP=true
MODEL_CACHE_DIR=E:/models

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

N8N_HOST=localhost
N8N_HOST_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_QUERY_WEBHOOK_URL=http://n8n:5678/webhook/fastapi-prod
N8N_QUERY_TIMEOUT=600
N8N_QUERY_CONNECT_TIMEOUT=10
N8N_API_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_PROGRESS_ENABLED=true
N8N_PROGRESS_POLL_INTERVAL=0.5
N8N_PROGRESS_LOOKBACK_SECONDS=5
EXECUTIONS_DATA_SAVE_ON_PROGRESS=true
N8N_QUERY_WORKFLOW_ID=hukvjyqCh8K1Nk4U
N8N_RETRIEVAL_WORKFLOW_ID=n6AyYe8rRw36dmOz
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT=30
FEISHU_FEEDBACK_WINDOW_SECONDS=1800

NEO4J_PASSWORD=change-me
