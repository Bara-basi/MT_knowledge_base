# Local development defaults.
# Copy this file to .env and adjust secrets/paths for your machine.

GENERIC_TIMEZONE=Asia/Shanghai

# Start the FastAPI process without requiring Milvus/model warmup at startup.
# Endpoints that use retrieval still require Milvus and model configuration.
SKIP_RETRIEVAL_WARMUP=true

# Milvus vector database. Required for retrieval/search endpoints.
MILVUS_URI=http://localhost:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=
MILVUS_COLLECTION_NAME=mtsco_knowledge_chunks
MILVUS_VECTOR_DIM=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_INDEX_M=16
MILVUS_INDEX_EF_CONSTRUCTION=200

# PostgreSQL chat/history storage.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mtsco_knowledge_base
POSTGRES_USER=mtsco
POSTGRES_PASSWORD=
POSTGRES_CHAT_TABLE=chat_messages
POSTGRES_EXTERNAL_CHAT_TABLE=chat_messages_external
POSTGRES_TIMEZONE=Asia/Shanghai
DATABASE_URL=
CHAT_MESSAGE_ENCRYPTION_KEY=change-me-to-a-long-random-chat-message-key

# MinIO object storage.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY_ID=change-me-access-key
MINIO_SECRET_ACCESS_KEY=change-me-secret-key
APP_MINIO_BUCKET=knowledge-raw-docs
MINIO_BUCKET=knowledge-raw-docs
MINIO_STANDARD_ASSET_BUCKET=knowledge-standard-assets
MINIO_PROCESSED_DOCUMENT_BUCKET=knowledge-processed-docs
MINIO_SECURE=false

# Alibaba Cloud OSS: canonical raw knowledge-document storage.
ALIYUN_OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_RAW_DATA_BUCKET=

# Embedding/reranker models.
USE_LOCAL_EMBEDDING_MODEL=true
USE_LOCAL_RERANK_MODEL=true
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_CACHE_DIR=data/models
RERANKER_CACHE_DIR=data/models
EMBEDDING_DEVICE=
RERANKER_DEVICE=
EMBEDDING_BATCH_SIZE=16
JIEBA_EXPANDED_VOCAB_FILE=data\vocab\expanded_vocab.csv
JIEBA_EXPANDED_VOCAB_FREQ=100000
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RETRIEVAL_RECALL_MULTIPLIER=5
RERANK_SCORE_THRESHOLD=0.1
RERANK_SCORE_CLIFF_DELTA=0.7

# Official KIMI chat LLM used by QA generation and evaluation.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# SiliconFlow is used by embedding/rerank fallback and Feishu fast feedback.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
IMMEDIATE_FEEDBACK_MODEL=deepseek-ai/DeepSeek-V4-Flash
IMMEDIATE_FEEDBACK_ENABLE_THINKING=off
SILICONFLOW_TIMEOUT=180
SILICONFLOW_CONNECT_TIMEOUT=10
SILICONFLOW_READ_TIMEOUT=180
SILICONFLOW_WRITE_TIMEOUT=60
SILICONFLOW_POOL_TIMEOUT=10
LLM_TIMEOUT=180
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=180
LLM_WRITE_TIMEOUT=60
LLM_POOL_TIMEOUT=10

# Unified PDF parsing. Modes: never, auto, always. Set external vision to false
# only when page images must not be sent to the configured model provider.
PDF_OCR_DPI=300
PDF_VISION_DPI=160
PDF_TABLE_VISION_DPI=220
PDF_VISION_MAX_PIXELS=3000000
PDF_TABLE_VISION_MAX_PIXELS=2500000
# Per-call read limits. Required full-page line-correction failures abort the
# current PDF; optional table-only model failures may retain local extraction.
PDF_VISION_READ_TIMEOUT=120
PDF_TABLE_VISION_READ_TIMEOUT=120
# Auto mode skips full-page model cleanup for nearly empty OCR pages.
PDF_VISION_MIN_DRAFT_CHARS=40
# Disable one workload type after this many consecutive document-local timeouts
# or non-timeout model/protocol failures. Output-budget exhaustion opens the
# affected circuit immediately.
PDF_VISION_CIRCUIT_BREAKER_TIMEOUTS=2
PDF_VISION_CIRCUIT_BREAKER_FAILURES=2
# auto uses Moonshot temporary-file references and Data URLs for other providers.
PDF_VISION_IMAGE_TRANSPORT=auto
PDF_VISION_JPEG_QUALITY=85
# Retry only transient temporary-file upload failures such as WinError 10054,
# timeouts, HTTP 429 and provider 5xx. HTTP 4xx validation errors fail immediately.
VISION_UPLOAD_MAX_ATTEMPTS=3
VISION_UPLOAD_RETRY_BASE_SECONDS=0.75
PDF_FULL_PAGE_MAX_OUTPUT_TOKENS=2200
PDF_TABLE_MAX_OUTPUT_TOKENS=3000
PDF_MODEL_CLEANUP_MODE=auto
PDF_ALLOW_EXTERNAL_VISION=true
PDF_TABLE_VISION_ENABLED=true

# Temporary, user/session-isolated Harness attachments. Full parsed text is
# never injected into one model response and is removed on session archive.
HARNESS_ATTACHMENT_ROOT=data/harness_attachments
HARNESS_ATTACHMENT_MAX_BYTES=52428800
HARNESS_ATTACHMENT_TTL_SECONDS=86400
# Required only when the internal attachment API must accept non-loopback calls.
HARNESS_ATTACHMENT_API_TOKEN=

# Feishu/Lark integration. Leave empty unless webhook verification is needed.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT=30
FEISHU_FEEDBACK_WINDOW_SECONDS=1800
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TARGET_UNION_ID=on_ebc25d5669cabb3440819db2cfaa5c7c
DAILY_REPORT_TARGET_SESSION_ID=oc_b4325718ab22291bc7625ebd63d6f915
DAILY_REPORT_TIMEZONE=Asia/Shanghai
DAILY_REPORT_DEPARTMENTS=迈拓思学园
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_TARGET_UNION_ID=on_ebc25d5669cabb3440819db2cfaa5c7c
WEEKLY_REPORT_TARGET_SESSION_ID=oc_b4325718ab22291bc7625ebd63d6f915
WEEKLY_REPORT_TIMEZONE=Asia/Shanghai
WEEKLY_REPORT_DEPARTMENTS=迈拓思学园

# Neo4j container config, used by docker-compose.
NEO4J_PASSWORD=change-me-password
