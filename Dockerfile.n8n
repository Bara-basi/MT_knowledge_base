FROM node:24-bookworm-slim

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
        tini \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && npm install -g n8n@2.20.6 \
    && npm cache clean --force \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER node

WORKDIR /home/node

EXPOSE 5678

ENTRYPOINT ["tini", "--"]
CMD ["n8n", "start"]
