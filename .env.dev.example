# Optional local-only services. They are disabled unless their compose profile is used.
N8N_HOST=localhost
N8N_HOST_PORT=15678
N8N_WEBHOOK_URL=http://localhost:15678/
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
