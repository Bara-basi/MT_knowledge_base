COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
COMPOSE_PROJECT_NAME=mtsco-kb-dev
GENERIC_TIMEZONE=Asia/Shanghai

# Dev keeps official upstream images and package indexes by default.
INSTALL_TORCH=true
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

API_HOST_PORT=18000
API_ROUTE_PREFIX=
FEISHU_ROUTE_PREFIX=
DEV_PROXY_TARGET=
DEV_PROXY_TIMEOUT=600
PUBLIC_BASE_URL=https://your-public-domain.example/dev

POSTGRES_HOST_PORT=15432
POSTGRES_DB=mtsco_knowledge_base_dev
POSTGRES_USER=mtsco_dev
POSTGRES_PASSWORD=change-me
POSTGRES_CHAT_TABLE=chat_messages
POSTGRES_TIMEZONE=Etc/GMT+8
CHAT_MESSAGE_ENCRYPTION_KEY=change-me-to-a-long-random-chat-message-key

MILVUS_COLLECTION_NAME=mtsco_knowledge_chunks_dev
MILVUS_HOST_PORT=19531
MILVUS_HEALTH_HOST_PORT=19091
MILVUS_MINIO_ADDRESS=host.docker.internal:9000

MINIO_ACCESS_KEY_ID=change-me-access-key
MINIO_SECRET_ACCESS_KEY=change-me
MINIO_INTERNAL_ENDPOINT=http://host.docker.internal:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
APP_MINIO_BUCKET=knowledge-raw-docs-dev
MINIO_PROCESSED_DOCUMENT_BUCKET=knowledge-processed-docs-dev
MINIO_SECURE=false

USE_LOCAL_EMBEDDING_MODEL=false
USE_LOCAL_RERANK_MODEL=false
SKIP_RETRIEVAL_WARMUP=true
MODEL_CACHE_DIR=E:/models

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

N8N_QUERY_WEBHOOK_URL=http://host.docker.internal:5678/webhook/fastapi-test
N8N_QUERY_TIMEOUT=600
N8N_QUERY_CONNECT_TIMEOUT=10
DEV_N8N_API_BASE_URL=http://host.docker.internal:5678
DEV_N8N_API_KEY=
N8N_PROGRESS_ENABLED=true
N8N_PROGRESS_POLL_INTERVAL=0.5
N8N_PROGRESS_LOOKBACK_SECONDS=5
N8N_QUERY_WORKFLOW_ID=KZKRj0Y1QW2xTS0J
N8N_RETRIEVAL_WORKFLOW_ID=0N11uTxPrWDr7G9O

LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_TIMEOUT=30
FEISHU_FEEDBACK_WINDOW_SECONDS=1800
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TARGET_UNION_ID=on_ebc25d5669cabb3440819db2cfaa5c7c
DAILY_REPORT_TARGET_SESSION_ID=oc_b4325718ab22291bc7625ebd63d6f915
DAILY_REPORT_TIMEZONE=Asia/Shanghai
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_TARGET_UNION_ID=on_ebc25d5669cabb3440819db2cfaa5c7c
WEEKLY_REPORT_TARGET_SESSION_ID=oc_b4325718ab22291bc7625ebd63d6f915
WEEKLY_REPORT_TIMEZONE=Asia/Shanghai

NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687
